diff --git a/src/cube/state.cpp b/src/cube/state.cpp
index 9a1039d..1b81c26 100644
--- a/src/cube/state.cpp
+++ b/src/cube/state.cpp
@@ -31,14 +31,29 @@ Clamped validate(Config raw) {
     return out;
 }
 
+static int g_originWs = 1, g_originFace = 0, g_originFaces = 4, g_wsCount = 1;
+
 int faceOfWorkspace(int workspaceId, int faces) {
-    if (workspaceId < 1 || workspaceId > faces)
+    if (workspaceId < 1 || faces < 1)
         return -1;
-    return workspaceId - 1;
+    return (workspaceId - 1) % faces;
+}
+
+void setOrigin(int originWorkspace, int faces, int workspaceCount) {
+    g_originWs    = originWorkspace < 1 ? 1 : originWorkspace;
+    g_originFaces = faces < 1 ? 1 : faces;
+    g_originFace  = faceOfWorkspace(g_originWs, g_originFaces);
+    g_wsCount     = workspaceCount < g_originWs ? g_originWs : workspaceCount;
 }
 
 int workspaceOfFace(int face) {
-    return face + 1;
+    // Offset from the origin face, centred: with 4 faces that is 0, +1, +2 (back), -1.
+    int d = normalizeFace(face - g_originFace, g_originFaces);
+    if (d > g_originFaces / 2)
+        d -= g_originFaces;
+    // Wrap within 1..count, so next on the last workspace lands on 1 and prev on 1 on the last.
+    const int z = ((g_originWs - 1 + d) % g_wsCount + g_wsCount) % g_wsCount;
+    return z + 1;
 }
 
 int normalizeFace(int face, int faces) {
