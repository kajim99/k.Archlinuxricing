+
+// Workspaces in play: the `wp` count (fish, base 5) or the active one, if higher.
+static int workspaceCount(int active) {
+    int count = 5;
+    const char* run = getenv("XDG_RUNTIME_DIR");
+    const char* sig = getenv("HYPRLAND_INSTANCE_SIGNATURE");
+    if (run && sig) {
+        if (FILE* f = fopen((std::string(run) + "/hypr/" + sig + "/wp-count").c_str(), "r")) {
+            int n = 0;
+            if (fscanf(f, "%d", &n) == 1 && n > 0)
+                count = n;
+            fclose(f);
+        }
+    }
+    return active > count ? active : count;
+}
+
+// 0.57: workspace ids are a variant; -1 for special/none (not a cube face).
+static int activeNumberedID(const PHLMONITOR& mon) {
+    if (!mon->m_activeWorkspace)
+        return -1;
+    const auto id = mon->m_activeWorkspace->numberedID();
+    return id ? (int)*id : -1;
+}
 
