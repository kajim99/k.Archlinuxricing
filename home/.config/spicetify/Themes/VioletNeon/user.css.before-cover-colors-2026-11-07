/* VioletNeon — neon touches on top of color.ini (2026-11-03).
   Colors: violet #8703ff (dominant), bright violet #a020ff, neon blue #0059e7. */

/* Progress + volume bars: violet → blue, violet-heavy */
.x-progressBar-fillColor,
[data-testid="progress-bar"] [class*="fillColor"] {
    background: linear-gradient(90deg, #8703ff 0%, #8703ff 60%, #0059e7 100%) !important;
}
.progress-bar {
    --fg-color: #8703ff !important;
    --bg-color: #2c2050 !important;
}
.progress-bar:hover,
.progress-bar--isDragging {
    --fg-color: #a020ff !important;
}
.x-progressBar-sliderArea div,
.progress-bar__slider {
    background-color: #ffffff !important;
    box-shadow: 0 0 8px #a020ff !important;
}

/* Play buttons: violet with a soft glow */
[data-testid="control-button-playpause"],
[data-testid="play-button"] > span,
.main-playButton-PlayButton > button > span {
    background-color: #8703ff !important;
    color: #ffffff !important;
    box-shadow: 0 0 14px rgba(135, 3, 255, 0.55) !important;
}
[data-testid="control-button-playpause"]:hover,
[data-testid="play-button"]:hover > span {
    background-color: #a020ff !important;
    box-shadow: 0 0 20px rgba(160, 32, 255, 0.75) !important;
}

/* Active shuffle/repeat/lyrics etc.: blue instead of green */
[aria-checked="true"][data-testid^="control-button"] {
    color: #0059e7 !important;
}

/* Cards and rows: faint violet glow on hover */
.main-card-card:hover,
[data-encore-id="card"]:hover {
    box-shadow: 0 0 16px rgba(135, 3, 255, 0.30) !important;
}
.main-trackList-trackListRow:hover,
[data-testid="tracklist-row"]:hover {
    background-color: rgba(135, 3, 255, 0.12) !important;
}
.main-trackList-selected,
[data-testid="tracklist-row"][aria-selected="true"] {
    background-color: #290090 !important;
}

/* Scrollbars */
::-webkit-scrollbar-thumb { background-color: #4a3a6a !important; }
::-webkit-scrollbar-thumb:hover { background-color: #8703ff !important; }

/* Text selection */
::selection { background: #290090; color: #ffffff; }

/* Glass: the window itself is see-through via Hyprland (0.85); these make the inner
   panels float as frosted violet glass with a thin violet edge, like the bar's panels. */
.Root__nav-bar,
.Root__now-playing-bar,
.Root__right-sidebar aside,
.Root__main-view {
    background-color: rgba(28, 21, 51, 0.55) !important;
    backdrop-filter: blur(18px) saturate(140%) !important;
    border: 1px solid rgba(135, 3, 255, 0.30) !important;
    border-radius: 10px !important;
}
.Root__nav-bar > *,
.Root__right-sidebar aside > *,
.Root__main-view > div,
.main-view-container,
.main-view-container__scroll-node-child,
.main-yourLibraryX-libraryContainer,
.main-yourLibraryX-library {
    background-color: transparent !important;
}
.main-card-card,
[data-encore-id="card"] {
    background-color: rgba(44, 32, 80, 0.45) !important;
    backdrop-filter: blur(10px) !important;
    border: 1px solid rgba(135, 3, 255, 0.18) !important;
}
.main-contextMenu-menu,
[data-tippy-root] > div,
.GenericModal {
    background-color: rgba(20, 15, 36, 0.80) !important;
    backdrop-filter: blur(22px) saturate(150%) !important;
    border: 1px solid rgba(135, 3, 255, 0.40) !important;
}
