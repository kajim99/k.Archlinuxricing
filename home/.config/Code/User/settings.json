{
    // Violet/blue theme matching the Hyprland setup (dark purple-navy, violet #8703ff, blue #0059e7)
    "workbench.colorTheme": "Dark Modern",
    "workbench.iconTheme": "material-icon-theme",
    "workbench.colorCustomizations": {
        "focusBorder": "#8703ff",
        "foreground": "#f4f1ff",
        "descriptionForeground": "#9e5fff",
        "widget.border": "#29008e",
        "selection.background": "#45009e",
        "editor.background": "#0d0a1a",
        "editor.foreground": "#f4f1ff",
        "editorLineNumber.foreground": "#3b00b3",
        "editorLineNumber.activeForeground": "#8703ff",
        "editorCursor.foreground": "#8703ff",
        "editor.selectionBackground": "#45009e99",
        "editor.selectionHighlightBackground": "#45009e55",
        "editor.lineHighlightBackground": "#17122e",
        "editor.findMatchBackground": "#0059e766",
        "editor.findMatchHighlightBackground": "#0059e733",
        "editorBracketMatch.border": "#8703ff",
        "editorIndentGuide.background1": "#1f1839",
        "editorIndentGuide.activeBackground1": "#45009e",
        "editorWhitespace.foreground": "#282045",
        "editorWidget.background": "#17122e",
        "editorWidget.border": "#29008e",
        "editorSuggestWidget.background": "#17122e",
        "editorSuggestWidget.selectedBackground": "#45009e",
        "editorSuggestWidget.highlightForeground": "#8703ff",
        "editorHoverWidget.background": "#17122e",
        "editorGroupHeader.tabsBackground": "#08060f",
        "editorGroup.border": "#1f1839",
        "tab.activeBackground": "#0d0a1a",
        "tab.activeForeground": "#f4f1ff",
        "tab.activeBorderTop": "#8703ff",
        "tab.inactiveBackground": "#08060f",
        "tab.inactiveForeground": "#7d6bb3",
        "tab.border": "#08060f",
        "titleBar.activeBackground": "#08060f",
        "titleBar.activeForeground": "#f4f1ff",
        "titleBar.inactiveBackground": "#08060f",
        "activityBar.background": "#08060f",
        "activityBar.foreground": "#8703ff",
        "activityBar.inactiveForeground": "#3b00b3",
        "activityBar.activeBorder": "#8703ff",
        "activityBarBadge.background": "#0059e7",
        "activityBarBadge.foreground": "#ffffff",
        "sideBar.background": "#120e24",
        "sideBar.foreground": "#d9d3e6",
        "sideBar.border": "#1f1839",
        "sideBarTitle.foreground": "#8703ff",
        "sideBarSectionHeader.background": "#17122e",
        "list.activeSelectionBackground": "#45009e",
        "list.activeSelectionForeground": "#ffffff",
        "list.inactiveSelectionBackground": "#282045",
        "list.hoverBackground": "#1f1839",
        "list.highlightForeground": "#8703ff",
        "statusBar.background": "#112c5c",
        "statusBar.foreground": "#ffffff",
        "statusBar.noFolderBackground": "#45009e",
        "statusBar.debuggingBackground": "#8703ff",
        "statusBarItem.remoteBackground": "#8703ff",
        "panel.background": "#0d0a1a",
        "panel.border": "#29008e",
        "panelTitle.activeBorder": "#8703ff",
        "panelTitle.activeForeground": "#f4f1ff",
        "terminal.background": "#0d0a1a",
        "terminal.foreground": "#e0dcff",
        "terminalCursor.foreground": "#8703ff",
        "terminal.ansiBlue": "#0059e7",
        "terminal.ansiMagenta": "#8703ff",
        "terminal.ansiBrightMagenta": "#ac40ff",
        "input.background": "#17122e",
        "input.border": "#29008e",
        "inputOption.activeBorder": "#8703ff",
        "dropdown.background": "#17122e",
        "button.background": "#8703ff",
        "button.hoverBackground": "#9739ff",
        "button.secondaryBackground": "#112c5c",
        "badge.background": "#0059e7",
        "progressBar.background": "#8703ff",
        "scrollbarSlider.background": "#45009e55",
        "scrollbarSlider.hoverBackground": "#45009e99",
        "scrollbarSlider.activeBackground": "#8703ffaa",
        "minimap.background": "#0d0a1a",
        "menu.background": "#17122e",
        "menu.selectionBackground": "#45009e",
        "quickInput.background": "#17122e",
        "notifications.background": "#17122e",
        "gitDecoration.modifiedResourceForeground": "#0059e7",
        "gitDecoration.untrackedResourceForeground": "#5de4c7",
        "gitDecoration.deletedResourceForeground": "#ff5c8a"
    },
    // Code colors from the kitty palette
    "editor.tokenColorCustomizations": {
        "comments": "#6a5a96",
        "keywords": "#ac40ff",
        "functions": "#0059e7",
        "strings": "#5de4c7",
        "numbers": "#ffc777",
        "types": "#4fd6ff",
        "variables": "#f4f1ff",
        "textMateRules": [
            { "scope": "comment", "settings": { "fontStyle": "italic" } },
            { "scope": ["storage.type", "storage.modifier", "keyword.control"], "settings": { "foreground": "#8703ff" } },
            { "scope": ["constant.language", "constant.character"], "settings": { "foreground": "#ff7aa2" } }
        ]
    },

    // Font: Monaspace Krypton with ligatures + texture healing (calt)
    "editor.fontFamily": "'JetBrainsMono Nerd Font', monospace",
    "editor.fontLigatures": "'calt', 'liga', 'ss01', 'ss02', 'ss03', 'ss04', 'ss05', 'ss06', 'ss07', 'ss08'",
    "editor.fontSize": 14,
    "editor.lineHeight": 1.5,
    "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font'",
    "terminal.integrated.fontSize": 14,

    "editor.cursorBlinking": "smooth",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.smoothScrolling": true,
    "workbench.list.smoothScrolling": true,
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": "active",
    "window.titleBarStyle": "custom"
,
  "material-code.primaryColor": "#3d8bff"
}
