#!/usr/bin/env python3
# Focus the terminal running Claude Code (tapped from the PhoneBox AI page). If none runs: a notification
# "Claude not found ¯\_(ツ)_/¯" on the PC + push "claude-status" so the phone shows it too. (2026-11-17)
import json, os, subprocess, time, urllib.request

def ppid(p):
    try:
        return int(open(f"/proc/{p}/stat").read().rsplit(")", 1)[1].split()[1])
    except OSError:
        return 0

clients = json.loads(subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True).stdout or "[]")
win = {c["pid"]: c for c in clients}
target = None
for p in subprocess.run(["pgrep", "-x", "claude"], capture_output=True, text=True).stdout.split():
    p = int(p)
    while p > 1 and p not in win:
        p = ppid(p)
    if p in win:
        target = p
        break

if target:
    subprocess.run(["hyprctl", "dispatch", f'hl.dsp.focus({{ window = "pid:{target}" }})'], capture_output=True)
    msg = "focused"
else:
    msg = "Claude not found ¯\\_(ツ)_/¯"
    subprocess.run(["notify-send", "-a", "Claude", msg])
try:
    req = urllib.request.Request("http://127.0.0.1:8765/api/push/claude-status",
                                 json.dumps({"msg": msg, "at": int(time.time() * 1000)}).encode(),
                                 {"Content-Type": "application/json"}, method="POST")
    urllib.request.urlopen(req, timeout=3).read()
except Exception:
    pass
