#!/usr/bin/env bash
# phnet-watch (2026-11-23): runs "phnet on" once each time the TECNO phone is plugged in (user service phnet-watch).
# Only the phone is touched, never the tablet (tethering on the tablet made its USB flap, 2026-11-20).
# A manual "phnet off" sticks until the phone is unplugged ($XDG_RUNTIME_DIR/phnet-manual-off, made by phnet off).
# If switching USB mode knocks the phone off adb, it notifies and stops until next login.
PHONE=130243753D002363
FLAG=$XDG_RUNTIME_DIR/phnet-manual-off
plugged() { grep -qx "$PHONE" /sys/bus/usb/devices/*/serial 2>/dev/null; }
online() { adb devices 2>/dev/null | grep -q "^$PHONE[[:space:]]*device"; }

done_this_plug=""
while true; do
    if ! plugged; then
        done_this_plug=""; rm -f "$FLAG"
    elif [ -z "$done_this_plug" ] && online; then
        done_this_plug=1
        if [ ! -e "$FLAG" ]; then
            "$HOME/.local/bin/phnet" on >/dev/null 2>&1
            sleep 20
            if plugged && ! online; then
                notify-send -a Phone -u critical "phnet: phone dropped off adb" "Turn USB debugging off and on. Auto ethernet is paused until next login."
                exit 0
            fi
        fi
    fi
    sleep 5
done
